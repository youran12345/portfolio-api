# ---- Copy this file to .env and fill in your real values ----

# Port the API listens on (Render sets this automatically)
PORT=5000

# MongoDB Atlas connection string
# Create a free cluster at https://www.mongodb.com/atlas, then copy the URI here.
# Example: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/portfolio?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/portfolio?retryWrites=true&w=majority

# Secret used to sign JSON Web Tokens (use a long random string)
JWT_SECRET=change_this_to_a_long_random_secret_string

# development | production
NODE_ENV=development

# Origin of the deployed front-end (for CORS). Add more origins separated by commas if needed.
CLIENT_URL=http://localhost:5173
